<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Passoid · пасс-детектор</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', 'Segoe UI', system-ui, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      /* ----- ТРАНСГЕНДЕРНЫЙ ФЛАГ (ГОРИЗОНТАЛЬНЫЕ ПОЛОСЫ) ----- */
      background: linear-gradient(
        180deg,
        #5bcefa 0%,      /* голубой (мужской) */
        #5bcefa 20%,
        #f5a9b8 20%,     /* розовый (женский) */
        #f5a9b8 40%,
        #ffffff 40%,     /* белый (нейтральный) */
        #ffffff 60%,
        #f5a9b8 60%,     /* розовый */
        #f5a9b8 80%,
        #5bcefa 80%,     /* голубой */
        #5bcefa 100%
      );
      background-size: 100% 100%;
      position: relative;
    }

    /* Полупрозрачная тень поверх флага для читаемости */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      z-index: 0;
    }

    /* ----- ОСНОВНАЯ КАРТОЧКА ----- */
    .passoid-card {
      position: relative;
      z-index: 1;
      max-width: 780px;
      width: 100%;
      background: rgba(10, 10, 25, 0.78);
      backdrop-filter: blur(20px) saturate(1.3);
      -webkit-backdrop-filter: blur(20px) saturate(1.3);
      border-radius: 56px;
      padding: 36px 32px 44px;
      border: 2px solid rgba(255, 255, 255, 0.08);
      box-shadow: 0 40px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.03);
      transition: all 0.3s ease;
    }

    /* ----- HEADER ----- */
    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px 20px;
      margin-bottom: 6px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .logo-icon {
      font-size: 2.8rem;
      line-height: 1;
      filter: drop-shadow(0 0 25px rgba(91, 206, 250, 0.15));
    }

    .logo h1 {
      font-weight: 700;
      font-size: 2.4rem;
      letter-spacing: -0.5px;
      background: linear-gradient(135deg, #5bcefa 0%, #f5a9b8 50%, #ffffff 80%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      text-shadow: none;
    }

    .badge-version {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.06);
      padding: 4px 18px;
      border-radius: 40px;
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.3);
      letter-spacing: 0.5px;
      font-weight: 500;
      backdrop-filter: blur(4px);
    }

    .subtitle {
      color: rgba(255, 255, 255, 0.25);
      font-weight: 300;
      font-size: 0.9rem;
      padding-left: 4px;
      margin-bottom: 28px;
      border-left: 3px solid #f5a9b8;
      padding-left: 16px;
      letter-spacing: 0.2px;
    }
    .subtitle strong {
      color: rgba(255, 255, 255, 0.4);
      font-weight: 400;
    }

    /* ----- UPLOAD ZONE (полупрозрачная) ----- */
    .upload-zone {
      background: rgba(91, 206, 250, 0.03);
      border: 2px dashed rgba(91, 206, 250, 0.12);
      border-radius: 32px;
      padding: 32px 20px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-bottom: 24px;
      position: relative;
    }

    .upload-zone:hover {
      border-color: #f5a9b8;
      background: rgba(245, 169, 184, 0.04);
      box-shadow: 0 0 40px rgba(245, 169, 184, 0.03);
    }

    .upload-zone.dragover {
      border-color: #5bcefa;
      background: rgba(91, 206, 250, 0.06);
      box-shadow: 0 0 60px rgba(91, 206, 250, 0.05);
    }

    .upload-zone input {
      display: none;
    }

    .upload-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .upload-icon {
      font-size: 3.6rem;
      line-height: 1;
      filter: drop-shadow(0 0 30px rgba(245, 169, 184, 0.1));
    }

    .upload-text {
      font-size: 1.05rem;
      color: rgba(255, 255, 255, 0.45);
      background: rgba(255, 255, 255, 0.02);
      padding: 10px 32px;
      border-radius: 60px;
      border: 1px solid rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(4px);
      font-weight: 300;
      letter-spacing: 0.3px;
    }

    .upload-hint {
      font-size: 0.7rem;
      color: rgba(255, 255, 255, 0.12);
      margin-top: 2px;
    }

    /* ----- PREVIEW ----- */
    .preview-wrap {
      display: flex;
      justify-content: center;
      margin: 8px 0 22px 0;
    }

    #previewImg {
      max-width: 100%;
      max-height: 320px;
      border-radius: 24px;
      box-shadow: 0 20px 40px -8px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.04);
      background: rgba(0, 0, 0, 0.3);
      object-fit: contain;
      display: none;
      transition: opacity 0.4s ease;
    }

    /* ----- RESULT PANEL ----- */
    .result-panel {
      background: rgba(0, 0, 0, 0.25);
      backdrop-filter: blur(8px);
      border-radius: 32px;
      padding: 24px 26px 28px;
      border: 1px solid rgba(255, 255, 255, 0.03);
      margin-top: 4px;
    }

    .gender-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 24px;
    }

    .gender-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 8px 0;
    }

    .gender-item .label {
      display: flex;
      align-items: center;
      gap: 12px;
      color: rgba(255, 255, 255, 0.35);
      font-weight: 300;
      font-size: 0.95rem;
    }

    .gender-item .label .icon {
      font-size: 1.8rem;
      line-height: 1;
    }

    .gender-item .value {
      font-size: 2.2rem;
      font-weight: 600;
      color: white;
      min-width: 72px;
      text-align: right;
      letter-spacing: -0.5px;
    }

    .gender-item .value.female-value {
      color: #f5a9b8;
    }
    .gender-item .value.male-value {
      color: #5bcefa;
    }

    /* Прогресс-бары в стиле транс-флага */
    .bars {
      margin: 16px 0 12px 0;
      display: flex;
      height: 10px;
      border-radius: 20px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.04);
      box-shadow: inset 0 1px 3px rgba(0,0,0,0.3);
    }

    .bar-female {
      height: 100%;
      background: linear-gradient(90deg, #f5a9b8, #f7c5d4);
      width: 50%;
      transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      border-radius: 20px 0 0 20px;
      box-shadow: 0 0 20px rgba(245, 169, 184, 0.15);
    }

    .bar-male {
      height: 100%;
      background: linear-gradient(90deg, #7dd3fc, #5bcefa);
      width: 50%;
      transition: width 0.7s cubic-bezier(0.22, 1, 0.36, 1);
      border-radius: 0 20px 20px 0;
      box-shadow: 0 0 20px rgba(91, 206, 250, 0.15);
    }

    .stats-row {
      display: flex;
      justify-content: space-between;
      color: rgba(255, 255, 255, 0.15);
      font-size: 0.8rem;
      letter-spacing: 0.3px;
      padding: 0 4px;
    }

    .stats-row .ratio {
      color: rgba(255, 255, 255, 0.25);
      font-weight: 400;
    }

    /* ----- PASSNESS INDICATOR ----- */
    .passness-block {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.04);
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 12px;
    }

    .passness-label {
      display: flex;
      align-items: center;
      gap: 12px;
      color: rgba(255, 255, 255, 0.25);
      font-weight: 300;
      font-size: 0.9rem;
    }

    .passness-label .badge {
      background: rgba(255, 255, 255, 0.03);
      padding: 2px 14px;
      border-radius: 40px;
      font-size: 0.65rem;
      color: rgba(255, 255, 255, 0.15);
    }

    .passness-meter {
      flex: 1;
      min-width: 120px;
      height: 6px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 20px;
      overflow: hidden;
      position: relative;
    }

    .passness-fill {
      height: 100%;
      width: 50%;
      border-radius: 20px;
      background: linear-gradient(90deg, #f5a9b8, #ffffff, #5bcefa);
      transition: width 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      box-shadow: 0 0 30px rgba(91, 206, 250, 0.1);
    }

    .passness-value {
      font-size: 1.4rem;
      font-weight: 600;
      min-width: 64px;
      text-align: right;
      background: linear-gradient(135deg, #f5a9b8, #5bcefa);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    /* ----- BUTTONS ----- */
    .actions {
      display: flex;
      justify-content: center;
      gap: 16px;
      margin-top: 22px;
      flex-wrap: wrap;
    }

    .btn {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      color: rgba(255, 255, 255, 0.4);
      padding: 12px 28px;
      border-radius: 60px;
      font-weight: 500;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all 0.25s ease;
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 0.2px;
    }

    .btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 30px rgba(0,0,0,0.3);
    }

    .btn-primary {
      background: linear-gradient(135deg, rgba(91, 206, 250, 0.1), rgba(245, 169, 184, 0.1));
      border-color: rgba(91, 206, 250, 0.12);
      color: rgba(255, 255, 255, 0.6);
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, rgba(91, 206, 250, 0.18), rgba(245, 169, 184, 0.18));
      border-color: #5bcefa;
      color: white;
    }

    .btn-secondary {
      background: rgba(255, 255, 255, 0.02);
      border-color: rgba(255, 255, 255, 0.03);
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(255, 255, 255, 0.08);
    }

    /* ----- STATUS ----- */
    .status {
      text-align: center;
      color: rgba(255, 255, 255, 0.12);
      font-size: 0.8rem;
      margin-top: 18px;
      font-weight: 300;
      letter-spacing: 0.3px;
      min-height: 1.4em;
      transition: color 0.3s ease;
    }

    .status.active {
      color: rgba(255, 255, 255, 0.3);
    }

    .footer {
      text-align: center;
      color: rgba(255, 255, 255, 0.04);
      font-size: 0.6rem;
      margin-top: 22px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
    }

    /* ----- Адаптивность ----- */
    @media (max-width: 550px) {
      .passoid-card { padding: 24px 16px 30px; border-radius: 36px; }
      .logo h1 { font-size: 1.6rem; }
      .gender-grid { grid-template-columns: 1fr; gap: 4px; }
      .gender-item .value { font-size: 1.8rem; min-width: 60px; }
      .passness-block { flex-direction: column; align-items: stretch; }
      .passness-value { text-align: left; }
      .btn { padding: 10px 18px; font-size: 0.8rem; }
      .upload-text { font-size: 0.9rem; padding: 8px 20px; }
    }
  </style>
</head>
<body>

<div class="passoid-card">
  <!-- HEADER -->
  <div class="header">
    <div class="logo">
      <span class="logo-icon">🏳️‍⚧️</span>
      <h1>Passoid</h1>
    </div>
    <span class="badge-version">v2.0 · пасс-анализ</span>
  </div>
  <div class="subtitle">
    <strong>Глубинный анализ</strong> · определение соответствия гендерному восприятию
  </div>

  <!-- UPLOAD -->
  <div class="upload-zone" id="uploadZone">
    <input type="file" id="fileInput" accept="image/*">
    <div class="upload-content">
      <span class="upload-icon">📸</span>
      <span class="upload-text">Загрузить фото или перетащить</span>
      <span class="upload-hint">PNG, JPG, WEBP · макс. 20 МБ</span>
    </div>
  </div>

  <!-- PREVIEW -->
  <div class="preview-wrap">
    <img id="previewImg" src="" alt="превью">
  </div>

  <!-- RESULT -->
  <div class="result-panel" id="resultPanel">
    <div class="gender-grid">
      <div class="gender-item">
        <span class="label"><span class="icon">♀</span> Женское</span>
        <span class="value female-value" id="femalePercent">50%</span>
      </div>
      <div class="gender-item">
        <span class="label"><span class="icon">♂</span> Мужское</span>
        <span class="value male-value" id="malePercent">50%</span>
      </div>
    </div>

    <!-- Bars -->
    <div class="bars">
      <div class="bar-female" id="barFemale" style="width:50%"></div>
      <div class="bar-male" id="barMale" style="width:50%"></div>
    </div>
    <div class="stats-row">
      <span>♀</span>
      <span class="ratio" id="ratioLabel">⚖️ 1 : 1</span>
      <span>♂</span>
    </div>

    <!-- PASSNESS -->
    <div class="passness-block">
      <div class="passness-label">
        <span>🏳️‍⚧️</span> Pass-индекс
        <span class="badge">совпадение</span>
      </div>
      <div class="passness-meter">
        <div class="passness-fill" id="passnessFill" style="width:50%"></div>
      </div>
      <span class="passness-value" id="passnessValue">50%</span>
    </div>

    <!-- ACTIONS -->
    <div class="actions">
      <button class="btn btn-primary" id="analyzeBtn">🎯 Глубокий анализ</button>
      <button class="btn btn-secondary" id="randomBtn">🎲 Случайный тест</button>
      <button class="btn btn-secondary" id="resetBtn">⟳ Сброс</button>
    </div>

    <div class="status" id="statusMessage">Загрузите изображение для пасс-анализа</div>
  </div>

  <div class="footer">Passoid Engine · транс-инклюзивная детекция</div>
</div>

<script>
  (function() {
    'use strict';

    // ---- DOM ----
    const fileInput = document.getElementById('fileInput');
    const uploadZone = document.getElementById('uploadZone');
    const previewImg = document.getElementById('previewImg');
    const femalePercentEl = document.getElementById('femalePercent');
    const malePercentEl = document.getElementById('malePercent');
    const barFemale = document.getElementById('barFemale');
    const barMale = document.getElementById('barMale');
    const ratioLabel = document.getElementById('ratioLabel');
    const passnessFill = document.getElementById('passnessFill');
    const passnessValue = document.getElementById('passnessValue');
    const statusMsg = document.getElementById('statusMessage');
    const analyzeBtn = document.getElementById('analyzeBtn');
    const randomBtn = document.getElementById('randomBtn');
    const resetBtn = document.getElementById('resetBtn');

    // ---- УСЛОЖНЁННЫЙ АЛГОРИТМ "Passoid" ----
    function advancedGenderAnalysis(imageData) {
      const data = imageData.data;
      const w = imageData.width;
      const h = imageData.height;
      const len = data.length;
      const totalPixels = w * h;

      let rSum = 0, gSum = 0, bSum = 0;
      let textureScore = 0;
      let saturationSum = 0;
      let brightnessSum = 0;

      const step = 2;
      let sampleCount = 0;

      for (let y = 0; y < h; y += step) {
        for (let x = 0; x < w; x += step) {
          const idx = (y * w + x) * 4;
          if (idx + 3 >= len) continue;

          const r = data[idx];
          const g = data[idx + 1];
          const b = data[idx + 2];

          rSum += r;
          gSum += g;
          bSum += b;

          const brightness = (r + g + b) / 3;
          brightnessSum += brightness;

          const avg = (r + g + b) / 3;
          const sat = Math.sqrt(((r - avg) ** 2 + (g - avg) ** 2 + (b - avg) ** 2) / 3);
          saturationSum += sat;

          if (x + step < w && y + step < h) {
            const idxRight = (y * w + (x + step)) * 4;
            const idxDown = ((y + step) * w + x) * 4;
            if (idxRight + 3 < len && idxDown + 3 < len) {
              const drR = Math.abs(data[idx] - data[idxRight]);
              const drG = Math.abs(data[idx+1] - data[idxRight+1]);
              const drB = Math.abs(data[idx+2] - data[idxRight+2]);
              const ddR = Math.abs(data[idx] - data[idxDown]);
              const ddG = Math.abs(data[idx+1] - data[idxDown+1]);
              const ddB = Math.abs(data[idx+2] - data[idxDown+2]);
              const diffH = (drR + drG + drB) / 3;
              const diffV = (ddR + ddG + ddB) / 3;
              textureScore += (diffH + diffV) / 2;
            }
          }
          sampleCount++;
        }
      }

      if (sampleCount === 0) return { female: 0.5, male: 0.5, passness: 0.5 };

      const avgR = rSum / sampleCount;
      const avgG = gSum / sampleCount;
      const avgB = bSum / sampleCount;
      const avgBright = brightnessSum / sampleCount;
      const avgSat = saturationSum / sampleCount;
      const textureAvg = textureScore / sampleCount;

      // ФАКТОР 1: Цветовой баланс
      const warmScore = (avgR - avgB) / 255;
      let colorFactor = 0.5 + warmScore * 0.35;
      const satNorm = Math.min(1, avgSat / 80);
      colorFactor = colorFactor + (colorFactor - 0.5) * satNorm * 0.2;

      // ФАКТОР 2: Текстура
      const textureNorm = Math.min(1, textureAvg / 70);
      let textureFactor = 0.5 - (textureNorm - 0.3) * 0.4;
      textureFactor = Math.max(0, Math.min(1, textureFactor));

      // ФАКТОР 3: Яркость
      const brightNorm = avgBright / 255;
      let brightnessWeight = 1.0;
      if (brightNorm < 0.12 || brightNorm > 0.88) {
        brightnessWeight = 0.6;
      }

      // ФАКТОР 4: Контрастность
      let contrastEst = 0;
      let contrastSamples = 0;
      for (let y = 0; y < h; y += step*2) {
        for (let x = 0; x < w; x += step*2) {
          const idx = (y * w + x) * 4;
          if (idx + 3 >= len) continue;
          const bri = (data[idx] + data[idx+1] + data[idx+2]) / 3;
          contrastEst += Math.abs(bri - avgBright);
          contrastSamples++;
        }
      }
      const contrastNorm = contrastSamples > 0 ? Math.min(1, (contrastEst / contrastSamples) / 70) : 0.5;
      let contrastFactor = 0.5 + (contrastNorm - 0.4) * 0.3;

      // Сборка
      const weightColor = 0.40;
      const weightTexture = 0.25;
      const weightContrast = 0.20;
      const weightBright = 0.15;

      let female = 
        colorFactor * weightColor +
        textureFactor * weightTexture +
        (1 - contrastFactor) * weightContrast +
        0.5 * weightBright;

      female = 0.5 + (female - 0.5) * brightnessWeight;

      const seed = (avgR + avgG + avgB + avgSat * 10) % 100;
      const microVar = (seed / 100) * 0.06 - 0.03;
      female = Math.min(1, Math.max(0, female + microVar));

      female = Math.round(female * 1000) / 1000;
      const male = Math.round((1 - female) * 1000) / 1000;

      // PASS-ИНДЕКС
      const confidence = 1 - Math.abs(female - 0.5) * 1.2;
      let passRaw = 1 - Math.abs(female - 0.5) * 1.4;
      let passness = Math.min(1, Math.max(0.15, passRaw * 0.85 + 0.15));
      if (Math.abs(female - 0.5) < 0.08) {
        passness = passness * 0.7 + 0.15;
      }
      passness = Math.round(passness * 1000) / 1000;

      return { female, male, passness };
    }

    // ---- Вспомогательная: получить ImageData ----
    function getImageDataFromFile(file) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          let w = img.width;
          let h = img.height;
          const maxSize = 500;
          if (w > maxSize) { h = (maxSize / w) * h; w = maxSize; }
          if (h > maxSize) { w = (maxSize / h) * w; h = maxSize; }
          canvas.width = Math.floor(w);
          canvas.height = Math.floor(h);
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          resolve(ctx.getImageData(0, 0, canvas.width, canvas.height));
        };
        img.onerror = () => reject(new Error('Не удалось загрузить изображение'));
        img.src = URL.createObjectURL(file);
      });
    }

    // ---- Обновление UI ----
    function updateUI(female, male, passness) {
      const fPct = Math.round(female * 100);
      const mPct = Math.round(male * 100);
      const pPct = Math.round(passness * 100);

      femalePercentEl.textContent = fPct + '%';
      malePercentEl.textContent = mPct + '%';
      barFemale.style.width = fPct + '%';
      barMale.style.width = mPct + '%';

      passnessFill.style.width = pPct + '%';
      passnessValue.textContent = pPct + '%';

      const ratio = female > 0 ? (male / female) : (male === 0 ? 1 : 999);
      let ratioText = '';
      if (Math.abs(ratio - 1) < 0.01) ratioText = '⚖️ 1 : 1';
      else if (ratio > 1) ratioText = `♂ ${ratio.toFixed(2)} : 1 ♀`;
      else ratioText = `♀ ${(1/ratio).toFixed(2)} : 1 ♂`;
      ratioLabel.textContent = ratioText;

      const diff = Math.abs(female - male);
      let verdict = '';
      if (pPct >= 80) verdict = '✨ Высокий пасс-потенциал';
      else if (pPct >= 60) verdict = '🌱 Хорошие перспективы';
      else if (pPct >= 40) verdict = '🌀 Нейтральный профиль';
      else verdict = '🔍 Требуется детальный анализ';

      if (diff < 0.08) verdict += ' · андрогинный баланс';
      else if (female > male) verdict += ' · женский уклон';
      else verdict += ' · мужской уклон';

      statusMsg.textContent = `✅ ${verdict}`;
      statusMsg.className = 'status active';
    }

    // ---- Главный процесс ----
    async function processFile(file) {
      if (!file) return;
      try {
        const reader = new FileReader();
        reader.onload = (e) => {
          previewImg.src = e.target.result;
          previewImg.style.display = 'block';
        };
        reader.readAsDataURL(file);

        const imageData = await getImageDataFromFile(file);
        const { female, male, passness } = advancedGenderAnalysis(imageData);
        updateUI(female, male, passness);
      } catch (err) {
        statusMsg.textContent = '⚠️ ' + err.message;
        statusMsg.className = 'status active';
      }
    }

    // ---- Случайный тест ----
    function randomTest() {
      let female, male, passness;
      const mode = Math.random();
      if (mode < 0.35) {
        female = 0.6 + Math.random() * 0.35;
      } else if (mode < 0.7) {
        female = 0.05 + Math.random() * 0.35;
      } else {
        female = 0.35 + Math.random() * 0.3;
      }
      female = Math.min(1, Math.max(0.01, female));
      female = Math.round(female * 1000) / 1000;
      male = Math.round((1 - female) * 1000) / 1000;

      const confidence = 1 - Math.abs(female - 0.5) * 1.1;
      let pRaw = 0.2 + confidence * 0.7 + Math.random() * 0.1;
      if (Math.abs(female - 0.5) < 0.06) pRaw = pRaw * 0.6 + 0.2;
      passness = Math.min(1, Math.max(0.1, pRaw));
      passness = Math.round(passness * 1000) / 1000;

      updateUI(female, male, passness);

      if (!previewImg.src || previewImg.style.display === 'none') {
        const canvas = document.createElement('canvas');
        canvas.width = 300;
        canvas.height = 200;
        const ctx = canvas.getContext('2d');
        const grd = ctx.createLinearGradient(0, 0, 300, 200);
        const hue1 = 180 + Math.floor(Math.random() * 60);
        const hue2 = 340 + Math.floor(Math.random() * 40);
        grd.addColorStop(0, `hsl(${hue1}, 60%, 50%)`);
        grd.addColorStop(1, `hsl(${hue2}, 60%, 40%)`);
        ctx.fillStyle = grd;
        ctx.fillRect(0, 0, 300, 200);
        ctx.fillStyle = 'rgba(255,255,255,0.04)';
        ctx.beginPath();
        ctx.ellipse(150, 80, 50, 60, 0, 0, Math.PI*2);
        ctx.fill();
        ctx.fillStyle = 'rgba(255,255,255,0.02)';
        ctx.beginPath();
        ctx.ellipse(150, 170, 70, 40, 0, 0, Math.PI*2);
        ctx.fill();
        previewImg.src = canvas.toDataURL();
        previewImg.style.display = 'block';
      }
      statusMsg.textContent = '🎲 Случайный симуляционный пасс-тест';
      statusMsg.className = 'status active';
    }

    // ---- Сброс ----
    function resetAll() {
      previewImg.style.display = 'none';
      previewImg.src = '';
      updateUI(0.5, 0.5, 0.5);
      statusMsg.textContent = 'Загрузите изображение для пасс-анализа';
      statusMsg.className = 'status';
      fileInput.value = '';
    }

    // ---- События ----
    uploadZone.addEventListener('click', () => fileInput.click());

    uploadZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadZone.classList.add('dragover');
    });

    uploadZone.addEventListener('dragleave', () => {
      uploadZone.classList.remove('dragover');
    });

    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.classList.remove('dragover');
      if (e.dataTransfer.files.length) {
        fileInput.files = e.dataTransfer.files;
        processFile(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files.length) {
        processFile(fileInput.files[0]);
      }
    });

    analyzeBtn.addEventListener('click', () => {
      if (fileInput.files.length) {
        processFile(fileInput.files[0]);
      } else {
        statusMsg.textContent = '⚠️ Сначала загрузите фотографию';
        statusMsg.className = 'status active';
      }
    });

    randomBtn.addEventListener('click', randomTest);
    resetBtn.addEventListener('click', resetAll);

    // ---- Инициализация ----
    resetAll();
  })();
</script>
</body>
</html>
